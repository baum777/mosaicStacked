# Minimal example. Add only the feature blocks you use.
# Core runtime works with defaults; the blocks below are for the enabled
# feature paths only.

PORT=8787
HOST=127.0.0.1
APP_NAME=mosaicstacked-local
DEFAULT_SYSTEM_PROMPT=You are a concise, reliable assistant operating through a local OpenRouter proxy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# OpenRouter / local profile chat.
# Normal user chat uses per-profile credentials saved in Settings.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_DEFAULT_LABEL=openrouter/free
OPENROUTER_API_KEY_QWEN3_CODER=
OPENROUTER_API_KEY_GPT_OSS_120B_PLANNER=
OPENROUTER_API_KEY_NEMOTRON_3_SUPER_120B=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=default
OPENROUTER_MODELS=

USER_CREDENTIALS_ENCRYPTION_KEY=
USER_CREDENTIALS_PROFILE_SECRET=
USER_CREDENTIALS_STORE_MODE=file
USER_CREDENTIALS_STORE_PATH=.local-ai/state/users

# Local auth.
MOSAIC_STACK_ADMIN_PASSWORD=
MOSAIC_STACK_SESSION_SECRET=
MOSAIC_STACK_SESSION_TTL_SECONDS=86400

# GitHub integration.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_INSTALLATION_ID=
GITHUB_AGENT_API_KEY=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_OAUTH_SCOPES=read:user,user:email

INTEGRATION_AUTH_STORE_MODE=file
INTEGRATION_AUTH_STORE_FILE_PATH=.local-ai/state/integration-auth-store.json
INTEGRATION_AUTH_ENCRYPTION_CURRENT_KEY_ID=integration-auth-v1
INTEGRATION_AUTH_ENCRYPTION_CURRENT_KEY_VERSION=1
INTEGRATION_AUTH_ENCRYPTION_CURRENT_KEY=
INTEGRATION_AUTH_ENCRYPTION_PREVIOUS_KEYS=

# Matrix integration.
MATRIX_ENABLED=true
MATRIX_REQUIRED=false
MATRIX_BASE_URL=https://matrix.org
MATRIX_HOMESERVER_URL=https://matrix.org
MATRIX_SSO_CALLBACK_URL=http://localhost:8787/api/auth/matrix/callback
MATRIX_EXPECTED_USER_ID=
MATRIX_ACCESS_TOKEN=
MATRIX_REFRESH_TOKEN=
MATRIX_CLIENT_ID=mosaicstacked-backend
MATRIX_TOKEN_EXPIRES_AT=
MATRIX_REQUEST_TIMEOUT_MS=5000
MATRIX_FAIL_CLOSED=true

# Optional Matrix evidence writes.
MATRIX_EVIDENCE_WRITES_ENABLED=false
MATRIX_EVIDENCE_WRITES_REQUIRED=false
MATRIX_EVIDENCE_ROOM_ID=
MATRIX_EVIDENCE_APPROVALS_ROOM_ID=
MATRIX_EVIDENCE_PROVENANCE_ROOM_ID=
MATRIX_EVIDENCE_VERIFICATION_ROOM_ID=
MATRIX_EVIDENCE_TOPIC_CHANGE_ROOM_ID=

{
  "version": 2,
  "buildCommand": "npm run build:web",
  "outputDirectory": "web/dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "config/*.yml"
    },
    "api/matrix/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "config/*.yml"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/models",
      "destination": "/api/models"
    },
    {
      "source": "/models/openrouter",
      "destination": "/api/models/openrouter"
    },
    {
      "source": "/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/settings/openrouter/status",
      "destination": "/api/settings/openrouter/status"
    },
    {
      "source": "/settings/openrouter/credentials",
      "destination": "/api/settings/openrouter/credentials"
    },
    {
      "source": "/settings/openrouter/test",
      "destination": "/api/settings/openrouter/test"
    },
    {
      "source": "/diagnostics",
      "destination": "/api/diagnostics"
    },
    {
      "source": "/journal/recent",
      "destination": "/api/journal/recent"
    },
    {
      "source": "/api/matrix/:path*",
      "destination": "/api/matrix/[...path]"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/:path*",
      "destination": "/"
    }
  ]
}

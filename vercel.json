{
  "version": 2,
  "buildCommand": "npm run build:web",
  "outputDirectory": "web/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "config/*.yml"
    },
    "api/matrix/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "config/*.yml"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/models",
      "destination": "/api/models"
    },
    {
      "source": "/models/openrouter",
      "destination": "/api/models/openrouter"
    },
    {
      "source": "/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/settings/openrouter/status",
      "destination": "/api/settings/openrouter/status"
    },
    {
      "source": "/settings/openrouter/credentials",
      "destination": "/api/settings/openrouter/credentials"
    },
    {
      "source": "/settings/openrouter/test",
      "destination": "/api/settings/openrouter/test"
    },
    {
      "source": "/diagnostics",
      "destination": "/api/diagnostics"
    },
    {
      "source": "/journal/recent",
      "destination": "/api/journal/recent"
    },
    {
      "source": "/api/matrix/:path*",
      "destination": "/api/matrix/[...path]"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/:path*",
      "destination": "/"
    }
  ]
}

{
  "name": "mosaicstacked",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "dependencies": {
    "react": "^19.2.5"
  },
  "scripts": {
    "dev:server:only": "npm run dev --workspace server",
    "dev:server": "npm run dev:server:only",
    "dev:web": "npm run dev --workspace web",
    "build:server": "npm run build --workspace server",
    "build:web": "npm run build --workspace web",
    "build": "npm run build:server && npm run build:web",
    "typecheck:server": "npm run typecheck --workspace server",
    "typecheck:web": "npm run typecheck --workspace web",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "test:server": "npm run test --workspace server",
    "test:web": "node --test --import tsx \"web/test/**/*.test.ts\"",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "cypress:open": "cypress open --e2e",
    "cypress:run": "cypress run --e2e",
    "smoke:matrix": "node scripts/matrix-smoke.mjs",
    "smoke:matrix-evidence": "node scripts/matrix-evidence-smoke.mjs",
    "smoke:github": "node scripts/github-smoke.mjs",
    "smoke:openrouter-prod": "node scripts/openrouter-production-readiness.mjs",
    "docs:update-ui-capture-evidence": "node scripts/update-ui-spec-capture-evidence.mjs",
    "test:matrix-live": "node --test --import tsx tests/live/matrix-smoke-live.test.ts",
    "test:matrix-evidence-live": "node --test --import tsx tests/live/matrix-evidence-smoke-live.test.ts",
    "test:integration-auth-rotation-live": "node --test --import tsx tests/live/integration-auth-rotation-live.test.ts",
    "test:integration-auth-rotation-live:matrix": "node --test --import tsx tests/live/integration-auth-rotation-live-matrix.test.ts",
    "test:integration-auth-rotation-live:both": "npm run test:integration-auth-rotation-live && npm run test:integration-auth-rotation-live:matrix",
    "perf:bundle:web": "npm run build --workspace web && node scripts/check-web-bundle-budget.mjs",
    "perf:lighthouse:tti": "node scripts/check-lighthouse-tti.mjs",
    "smoke:local": "npm run typecheck && npm run test && npm run test:browser",
    "smoke:ci": "npm run typecheck && npm run build && npm run test && npm run test:browser",
    "smoke": "npm run smoke:ci",
    "test": "npm run test:server && npm run test:web",
    "dev": "echo 'Use two terminals: npm run dev:server and npm run dev:web' && exit 1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/react": "^19.2.14",
    "cypress": "^15.14.2"
  }
}
